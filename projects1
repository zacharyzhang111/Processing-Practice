SoundFile s7;
void setup() {

  size(1000,1000);
  s1=new SoundFile(this,"drumloop.mp3");
  s2=new SoundFile(this,"drumloop.mp3");
  s3=new SoundFile(this,"drumloop.mp3");
  s4=new SoundFile(this,"drumloop.mp3");
  s5=new SoundFile(this,"drumloop.mp3");
  s6=new SoundFile(this,"drumloop.mp3");
  s7=new SoundFile(this,"drumloop.mp3");
  //colorMode(HSB, 360, 100, 100);
}
void keyPressed()
{ if(key=='a'){
  fill(255);
 rect(0,0,500,500);
  s1.play();
  
}if(key=='s'){
  s2.play();
}
if(key=='d'){
  s3.play();
}
if(key=='f'){
  s4.play();
}
if(key=='g'){
  s5.play();
}
if(key=='h'){
  s6.play();
}
if(key=='j'){
  s7.play();
}
}
void draw() {
  frameRate(5);
  background(255);
  fill(255,200,0);
  circle(200,200,100);
  circle(180,190,15);
  circle(220,190,15);
  rect(150,250,100,150);
  rect(185,220,30,10);
  rect(125,275,25,75);
   rect(250,275,25,75);
   rect(170,400,25,60);
   rect(205,400,25,60);
}

import processing.sound.*;
SoundFile sound;

void setup() {

  size(1000,1000);
  sound=new SoundFile(this,"beat.aiff");
  sound.loop();
  colorMode(HSB, 360, 100, 100);
}
void draw() {
  //background(100,0,0);
  noStroke();
  fill(0, 0, 0, 10);
  rect(0, 0, width, height);
  beginShape();
  //triangle(0,0,width,height,mouseX,mouseY);
  for (int x=0; x<width+20; x+=20) {
   
    float n=noise(x*0.001,frameCount*0.01);
     fill(n*360, 100, 100,20);
    float y=map(n,0,1,0,height);
    vertex(x, y);
  }
  endShape(CLOSE);
}
